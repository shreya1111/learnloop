# Express API
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
TRUST_PROXY=0

# Database and server-side API credentials
MONGODB_URI=mongodb://127.0.0.1:27017/courseit_clone
# Development only: start a local MongoDB container when the database is down.
# Ignored in production and for remote URIs. Set to "off" to disable.
DEV_DATABASE_AUTOSTART=on
JWT_SECRET=
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vite client; leave empty to use the local Vite proxy.
VITE_API_BASE_URL=
