{
  "name": "courseit-clone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "check:deploy": "node scripts/check-deploy.mjs",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
